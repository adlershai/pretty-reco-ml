.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example
.pytest_cache/
.DS_Store

# Hugging Face / torch caches if they land in the repo root
cache/
downloads/
.cache/
huggingface/
*.npy
*.pt
*.onnx
*.safetensors
# Promoted inference weights (needed on Adler for pretty-crm-api ranking)
!artifacts/the_pretty_model_v1/model.pt

# All generated local data: snapshots, ranking dumps, extra artifacts
local/*
!local/.gitkeep

# Legacy locations (ignored if an old checkout still has them)
snapshots/*
!snapshots/.gitkeep
outputs/*
!outputs/.gitkeep

# Local artifact dumps (keep the folder + promoted v1)
artifacts/*
!artifacts/.gitkeep
!artifacts/the_pretty_model_v1/
!artifacts/the_pretty_model_v1/**
