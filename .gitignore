.venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example
.pytest_cache/
.DS_Store

# Model caches, downloads, and generated embeddings
cache/
downloads/
.cache/
huggingface/
*.npy
*.pt
*.onnx
*.safetensors
# Promoted inference weights (needed on Adler for pretty-crm-api ranking)
!artifacts/the_pretty_model_v1/model.pt

# Generated training snapshots (keep the folder)
snapshots/*
!snapshots/.gitkeep

# Local artifact dumps (keep the folder + promoted v1)
artifacts/*
!artifacts/.gitkeep
!artifacts/the_pretty_model_v1/
!artifacts/the_pretty_model_v1/**

# Ranking / inference exports (keep the folder)
outputs/*
!outputs/.gitkeep
