# Service-to-service key for pretty-crm-api → pretty-reco-ml.
# Never send this to pretty-app or any browser. Generate with: openssl rand -hex 32
RECO_API_KEY=
EMBEDDING_BATCH_SIZE=12

# Training-data loader (step-db-server). Do not add MySQL credentials here.
DB_API_URL=https://db.adler-backend.com
DB_NAME=payments
# Optional if the DB API requires auth in a given environment
# DB_API_KEY=
# DB_API_TOKEN=
# DB_API_TIMEOUT=180

# Optional temporal split bounds (YYYY-MM-DD). Inclusive end dates.
# Default: TRAIN_END = latest purchase date - 120 days,
#          VALIDATION_END = latest purchase date - 60 days.
# If the snapshot is shorter than 120 days, unique-date quantiles (70% / 85%) are used.
# TRAIN_END=2025-12-31
# VALIDATION_END=2026-03-31

# Two-tower training. Default 2 threads so 04:00 jobs do not pin all 4 vCPUs.
# TORCH_NUM_THREADS=2

